{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dev Quality Gates tool registry",
  "type": "object",
  "required": ["tools"],
  "properties": {
    "$schema": { "type": "string" },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "repo", "category", "last_reviewed", "sources", "rationale", "limitations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
          "category": { "type": "string", "minLength": 1, "description": "README heading the entry is listed under; see CATEGORY_ORDER in scripts/readme.ts." },
          "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "rationale": { "type": "string", "minLength": 1, "description": "What the tool does: the README sentence." },
          "limitations": { "type": "string", "minLength": 1, "description": "Shown after 'Limits:' in the README." },
          "details": { "type": "string", "description": "Optional repository path of a longer comparison." },
          "stable_exception": { "type": "boolean", "description": "A finished tool with old releases: mutes the push-age and release-age flags." }
        }
      }
    }
  }
}
